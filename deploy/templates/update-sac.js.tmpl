    if (!sameValue(active, KIT.sacConfig)) problems.push('the active sac-compact config is not the shipped policy');
  } catch (e) { problems.push('the active sac-compact config cannot be read: ' + e.message); }
  if (problems.length) undoOnFailure('verification failed: ' + problems.join('; '));
  note('all ' + PAYLOAD.length + ' files match the kit (SHA-256); versions ' + versions.compact + ' / ' + versions.preset + '; the active config is the shipped policy');

  let code = EXIT.OK;
  if (ARGS.test) {
    const result = selfTest(targets);
    if (result.skipped) note('self-test skipped: ' + result.skipped);
    else if (result.error || result.fail > 0) { warn('self-test FAILED: ' + (result.error || result.fail + ' test(s) failed') + ' (the plugin is installed; review before relying on it)'); code = EXIT.TEST_FAILED; }
    else note('self-test: ' + result.pass + ' test(s) passed on node ' + process.versions.node);
  }
  console.log('');
  say((fresh ? 'install' : 'update') + ' complete: SAC ' + KIT.version + ', ' + method + ' method.');
  note('1. Fully quit and restart DeepSeek Harness (closing its window is not enough).' + (running ? ' It is running now.' : ''));
  note(method === 'global' ? '2. SAC is active in every session of profile "' + ARGS.profile + '".'
    : '2. Create a NEW session and pick the preset "SAC" (SAC single-action compaction); sessions on other presets never load it.');
  note('3. A fold logs "dsh-sac-compact: folded N action(s) ...". On a short dialogue nothing folds: that is intended.');
  note('4. Undo with: ' + launcherName() + ' -rollback -profile ' + ARGS.profile + '   (backup: ' + backup + ')');
  return code;
}

function doUninstall(state) {
  const backup = makeBackup(BACKUP_ROOT, 'uninstall', state);
  say('uninstalling from profile "' + ARGS.profile + '" (the current state is saved in ' + backup + ')');
  const pkg = safeJson(readText(PKG)) || {};
  if (pkg.dependencies) { delete pkg.dependencies[PRESET]; delete pkg.dependencies[COMPACT]; }
  pkg.dsh = pkg.dsh || {}; pkg.dsh.profile = pkg.dsh.profile || {};
  pkg.dsh.profile.bundles = (pkg.dsh.profile.bundles || []).filter((b) => b !== PRESET && b !== COMPACT);
  writeJson(PKG, pkg);
  note('package.json: SAC entries removed');
  for (const kind of KINDS) {
    const linkPath = path.join(NM_LOCAL, DIR[kind]);
    if (linkInfo(linkPath).isLink) fs.rmSync(linkPath, { force: true });
    else if (isSacDir(linkPath, kind)) fs.rmSync(linkPath, { recursive: true, force: true });
  }
  try { fs.rmdirSync(NM_LOCAL); } catch (e) {}
  if (ARGS.purge) {
    for (const kind of KINDS) {
      const dir = path.join(PLUGINS_DIR, DIR[kind]);
      if (isSacDir(dir, kind)) fs.rmSync(dir, { recursive: true, force: true });
    }
    try { fs.rmdirSync(PLUGINS_DIR); } catch (e) {}
    note('plugin files deleted under ' + PLUGINS_DIR);
  }
  say('uninstall complete. Restart the client to apply. Install again with: ' + launcherName() + ' -profile ' + ARGS.profile);
  return EXIT.OK;
}

main().then((code) => finish(code === undefined ? EXIT.OK : code), (e) => fail(EXIT.STOPPED, e && e.message ? e.message : String(e)));
