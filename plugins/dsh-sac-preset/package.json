{
  "name": "@local/dsh-sac-preset",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Agent preset `sac`: the standard composition plus the Single-Action Compaction policy, so SAC runs only in sessions that select this preset.",
  "exports": {
    ".": "./sac/index.js",
    "./sac": "./sac/index.js",
    "./locale/*.json": "./locale/*.json"
  },
  "dependencies": {
    "@local/dsh-sac-compact": "link:../dsh-sac-compact"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "sac",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md"
  ]
}
